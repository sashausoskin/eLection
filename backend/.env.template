PORT=3000 #The port number on which the server should run.
CORS_ORIGIN=http://localhost:5173 #Where requests should come from. Ignored if requests come from the same domain as where the backend runs.
CLEANUP_INTERVAL=300000 #How often the server should perform cleanup routine in ms.
LOBBY_TIMEOUT_LENGTH=7200000 #How long the lobby can stay inactive in ms before it is closed by the cleanup routine.
CODE_LENGTH=4 #How many digits the user codes and lobby codes should have.
PROXY_TRUST_DEPTH=1 # For rate limiting, use the address that is at most this many hops away. More info here: https://expressjs.com/en/5x/guide/behind-proxies/